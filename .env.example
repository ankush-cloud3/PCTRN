# Copy to .env and edit. All values are optional.

# Folder where received files are saved (default: ~/pctrn_received)
#create a separate folder with name of ur choice and add its path here
#it will store all the documents that is shared from your phone
PCTRN_SAVE_DIR=

# Port to serve on (default: 5000)
PCTRN_PORT=5000

# PIN required in the PC console to open links found in received text.
# Leave empty to disable link opening entirely.
PCTRN_LINK_PIN=

# Auto-shutdown after N minutes; 0 = run until Ctrl+C (default: 20)
PCTRN_SESSION_MINUTES=20
